# Entorno de ARCA. Cambiar a produccion solo cuando la homologación esté validada.
ARCA_ENV=homologacion

# CUIT que emite los comprobantes. En modelo A es el del cliente, no el del desarrollador.
ARCA_CUIT_EMISOR=20123456789

# Punto de venta de tipo Web Service. Verificar el número real con FEParamGetPtosVenta.
ARCA_PTO_VTA=1

# Certificado y clave en base64, sin saltos de línea:
#   base64 -i cert.crt | tr -d '\n'
#   base64 -i private.key | tr -d '\n'
ARCA_CERT_BASE64=
ARCA_KEY_BASE64=

DATABASE_URL=postgres://usuario:clave@host:5432/base
